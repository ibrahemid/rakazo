#!/usr/bin/env python3
from __future__ import annotations

import asyncio
import http.client
import json
import math
import os
import re
import sys
import time
import urllib.request
from typing import Any

ENV_NAME = "RAKAZO_COMPUTER_GEOLOCATION"
DEFAULT_ACCURACY_M = 50.0
STARTUP_TIMEOUT_S = 30.0
POLL_INTERVAL_S = 0.25
DECIMAL = re.compile(r"[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?")
EXIT_UNAVAILABLE = 1
EXIT_USAGE = 2


class GeolocationConfigError(Exception):
    pass


class BrowserUnavailableError(Exception):
    pass


class CdpCommandError(Exception):
    pass


class BrowserClosedError(Exception):
    pass


def log(message: str) -> None:
    print(f"rakazo-geo: {message}", file=sys.stderr, flush=True)


def parse_decimal(label: str, raw: str) -> float:
    text = raw.strip()
    if not DECIMAL.fullmatch(text):
        raise GeolocationConfigError(
            f"{ENV_NAME} {label} must be a decimal number, received {raw!r}"
        )
    value = float(text)
    if not math.isfinite(value):
        raise GeolocationConfigError(f"{ENV_NAME} {label} must be finite, received {raw!r}")
    return value


def parse_geolocation(raw: str) -> dict[str, float]:
    parts = raw.split(",")
    if len(parts) not in (2, 3):
        raise GeolocationConfigError(
            f'{ENV_NAME} must be "<lat>,<lng>[,<accuracy_m>]", received {raw!r}'
        )
    latitude = parse_decimal("latitude", parts[0])
    if not -90 <= latitude <= 90:
        raise GeolocationConfigError(
            f"{ENV_NAME} latitude must be between -90 and 90, received {parts[0].strip()!r}"
        )
    longitude = parse_decimal("longitude", parts[1])
    if not -180 <= longitude <= 180:
        raise GeolocationConfigError(
            f"{ENV_NAME} longitude must be between -180 and 180, received {parts[1].strip()!r}"
        )
    accuracy = DEFAULT_ACCURACY_M
    if len(parts) == 3:
        accuracy = parse_decimal("accuracy", parts[2])
        if accuracy <= 0:
            raise GeolocationConfigError(
                f"{ENV_NAME} accuracy must be greater than 0 metres, received {parts[2].strip()!r}"
            )
    return {"latitude": latitude, "longitude": longitude, "accuracy": accuracy}


def geolocation_from_env() -> dict[str, float]:
    raw = os.environ.get(ENV_NAME, "")
    if raw.strip() == "":
        raise GeolocationConfigError(f"{ENV_NAME} is not set")
    return parse_geolocation(raw)


def parse_port(raw: str) -> int:
    if not raw.isascii() or not raw.isdigit() or not 1 <= int(raw) <= 65535:
        raise GeolocationConfigError(
            f"DevTools port must be an integer from 1 to 65535, received {raw!r}"
        )
    return int(raw)


def browser_websocket_url(port: int) -> str:
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    url = f"http://127.0.0.1:{port}/json/version"
    deadline = time.monotonic() + STARTUP_TIMEOUT_S
    last_error = "no response"
    while True:
        try:
            with opener.open(url, timeout=2.0) as response:
                body = response.read(1024 * 1024)
            info = json.loads(body.decode("utf-8"))
            ws_url = info.get("webSocketDebuggerUrl") if isinstance(info, dict) else None
            if isinstance(ws_url, str) and ws_url:
                return ws_url
            last_error = "response has no webSocketDebuggerUrl"
        except (OSError, http.client.HTTPException, ValueError) as error:
            last_error = str(error) or type(error).__name__
        if time.monotonic() >= deadline:
            raise BrowserUnavailableError(
                f"Chromium DevTools on 127.0.0.1:{port} not ready after "
                f"{STARTUP_TIMEOUT_S:.0f}s: {last_error}"
            )
        time.sleep(POLL_INTERVAL_S)


class CdpConnection:
    def __init__(self, socket: Any) -> None:
        self._socket = socket
        self._next_id = 0
        self._pending: dict[int, asyncio.Future[dict[str, Any]]] = {}
        self._tasks: set[asyncio.Task[None]] = set()

    async def call(
        self, method: str, params: dict[str, Any] | None = None, session_id: str | None = None
    ) -> dict[str, Any]:
        self._next_id += 1
        message: dict[str, Any] = {"id": self._next_id, "method": method, "params": params or {}}
        if session_id:
            message["sessionId"] = session_id
        future: asyncio.Future[dict[str, Any]] = asyncio.get_running_loop().create_future()
        self._pending[self._next_id] = future
        await self._socket.send(json.dumps(message))
        response = await future
        error = response.get("error")
        if error is not None:
            raise CdpCommandError(f"{method} failed: {json.dumps(error)}")
        result = response.get("result")
        return result if isinstance(result, dict) else {}

    def spawn(self, coroutine: Any) -> None:
        task = asyncio.ensure_future(coroutine)
        self._tasks.add(task)
        task.add_done_callback(self._tasks.discard)

    def resolve(self, message: dict[str, Any]) -> None:
        future = self._pending.pop(message["id"], None)
        if future is not None and not future.done():
            future.set_result(message)

    def close(self) -> None:
        for future in self._pending.values():
            if not future.done():
                future.set_exception(BrowserClosedError("browser websocket closed"))
        self._pending.clear()
        for task in self._tasks:
            task.cancel()


class GeolocationPinner:
    def __init__(self, connection: CdpConnection, geolocation: dict[str, float]) -> None:
        self._connection = connection
        self._geolocation = geolocation
        self._page_sessions: dict[str, str] = {}

    def on_event(self, method: str, params: dict[str, Any]) -> None:
        if method == "Target.attachedToTarget":
            info = params.get("targetInfo")
            session_id = params.get("sessionId")
            if not isinstance(info, dict) or info.get("type") != "page":
                return
            if not isinstance(session_id, str) or not isinstance(info.get("targetId"), str):
                return
            self._page_sessions[session_id] = info["targetId"]
            self._connection.spawn(self._pin(session_id, info["targetId"]))
        elif method == "Target.detachedFromTarget":
            session_id = params.get("sessionId")
            if isinstance(session_id, str):
                self._page_sessions.pop(session_id, None)

    async def _pin(self, session_id: str, target_id: str) -> None:
        try:
            await self._connection.call(
                "Emulation.setGeolocationOverride", self._geolocation, session_id
            )
        except CdpCommandError as error:
            if session_id in self._page_sessions:
                log(f"page {target_id}: {error}")
        except BrowserClosedError:
            pass

    async def start(self) -> None:
        await self._connection.call("Browser.grantPermissions", {"permissions": ["geolocation"]})
        await self._connection.call("Target.setDiscoverTargets", {"discover": True})
        await self._connection.call(
            "Target.setAutoAttach",
            {"autoAttach": True, "waitForDebuggerOnStart": False, "flatten": True},
        )
        listed = await self._connection.call("Target.getTargets")
        attached = set(self._page_sessions.values())
        for info in listed.get("targetInfos", []):
            if not isinstance(info, dict) or info.get("type") != "page":
                continue
            target_id = info.get("targetId")
            if not isinstance(target_id, str) or target_id in attached:
                continue
            try:
                await self._connection.call(
                    "Target.attachToTarget", {"targetId": target_id, "flatten": True}
                )
            except CdpCommandError as error:
                log(f"page {target_id}: {error}")


async def pin_geolocation(ws_url: str, geolocation: dict[str, float]) -> None:
    try:
        import websockets
    except ImportError as error:
        raise BrowserUnavailableError("python3-websockets is not installed") from error

    try:
        socket = await websockets.connect(
            ws_url, max_size=None, ping_interval=None, open_timeout=10
        )
    except (websockets.WebSocketException, OSError, asyncio.TimeoutError) as error:
        raise BrowserUnavailableError(f"cannot open {ws_url}: {error}") from error

    connection = CdpConnection(socket)
    pinner = GeolocationPinner(connection, geolocation)

    async def read_messages() -> None:
        try:
            async for raw in socket:
                message = json.loads(raw)
                if not isinstance(message, dict):
                    continue
                if isinstance(message.get("id"), int):
                    connection.resolve(message)
                elif isinstance(message.get("method"), str):
                    params = message.get("params")
                    pinner.on_event(message["method"], params if isinstance(params, dict) else {})
        except websockets.ConnectionClosed:
            pass
        finally:
            connection.close()

    reader = asyncio.ensure_future(read_messages())
    try:
        try:
            await pinner.start()
        except BrowserClosedError:
            pass
        await reader
    finally:
        reader.cancel()
        await socket.close()


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        log("usage: rakazo-geo <devtools-port> | rakazo-geo --check")
        return EXIT_USAGE
    try:
        geolocation = geolocation_from_env()
        if argv[0] == "--check":
            print(json.dumps(geolocation))
            return 0
        port = parse_port(argv[0])
    except GeolocationConfigError as error:
        log(str(error))
        return EXIT_USAGE
    try:
        ws_url = browser_websocket_url(port)
        log(
            f"pinning {geolocation['latitude']},{geolocation['longitude']} "
            f"(accuracy {geolocation['accuracy']}m) on port {port}"
        )
        asyncio.run(pin_geolocation(ws_url, geolocation))
    except (BrowserUnavailableError, CdpCommandError) as error:
        log(str(error) or type(error).__name__)
        return EXIT_UNAVAILABLE
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
